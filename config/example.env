# Этот пример включён для соответствия структуре hacathon_template.
# Android-приложение не требует .env или сетевых ключей для локального ASR.
# Настройки продукта находятся в app/build.gradle.kts и AsrModelSpec.kt.
# Образец переменных для локальных *необязательных* тестовых скриптов:
OUTPUT_DIRECTORY=artifacts/test-results
OFFLINE_MODE=true
# Не добавляйте секреты и .env в Git.
